# AETHER OS Alpha 0.1 — small, explicit x86_64 package set.
# Do not use the full xfce4 group: install only the desktop components we need.
# Keep developer and Windows-compatibility stacks optional.

# Core and boot
base
linux
linux-firmware
amd-ucode
mkinitcpio
mkinitcpio-archiso
sudo

# Networking and Bluetooth
networkmanager
wpa_supplicant
bluez
bluez-utils

# Xorg and a deliberately minimal XFCE session
xorg-server
xf86-input-libinput
exo
garcon
thunar
tumbler
xfce4-appfinder
xfce4-panel
xfce4-power-manager
xfce4-session
xfce4-settings
xfce4-terminal
xfce4-notifyd
xfconf
xfdesktop
xfwm4
lightdm
lightdm-gtk-greeter
polkit
polkit-gnome

# Audio
pipewire
pipewire-alsa
pipewire-pulse
wireplumber
pavucontrol

# Desktop integration
network-manager-applet
xdg-user-dirs
xdg-utils
xdg-desktop-portal
xdg-desktop-portal-gtk
file-roller

# Memory pressure protection (swap stays in RAM; no disk swap is configured)
zram-generator

# Basic tools
git
curl
wget
nano
flatpak
