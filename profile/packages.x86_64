# AETHER OS Alpha — explicit x86_64 package set.
# Keep heavy developer and Windows-compatibility stacks optional.

# Core, boot and CPU microcode
base
linux
linux-firmware
linux-firmware-mediatek
linux-firmware-amdgpu
amd-ucode
mkinitcpio
mkinitcpio-archiso
sudo

# Networking and Bluetooth
networkmanager
wpa_supplicant
bluez
bluez-utils
blueman

# Graphics: Mesa OpenGL and AMD RADV Vulkan
mesa
vulkan-radeon

# Xorg and a deliberately small XFCE session
xorg-server
xf86-input-libinput
exo
garcon
thunar
tumbler
xfce4-appfinder
xfce4-panel
xfce4-power-manager
xfce4-session
xfce4-settings
xfce4-terminal
xfce4-notifyd
xfconf
xfdesktop
xfwm4
lightdm
lightdm-gtk-greeter
polkit
polkit-gnome

# AETHER desktop experience: searchable menu, dock, dark theme and icons
xfce4-whiskermenu-plugin
xfce4-docklike-plugin
xfce4-pulseaudio-plugin
adw-gtk-theme
papirus-icon-theme

# Audio
pipewire
pipewire-alsa
pipewire-pulse
wireplumber
pavucontrol

# Desktop integration
network-manager-applet
xdg-user-dirs
xdg-utils
xdg-desktop-portal
xdg-desktop-portal-gtk
file-roller
mousepad
xfce4-taskmanager
xfce4-screenshooter

# Laptop controls and hardware diagnostics
brightnessctl
acpi
lm_sensors
pciutils
usbutils

# Memory pressure protection (swap stays in RAM; no disk swap is configured)
zram-generator

# Basic tools
git
curl
wget
nano
flatpak
7zip
