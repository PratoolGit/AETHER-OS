#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<'HELP'
AETHER OS helper

Usage:
  aether help
  aether info
  aether network
  aether update
  aether search TERM
  aether install PACKAGE [PACKAGE...]
  aether remove PACKAGE [PACKAGE...]
  aether setup developer
  aether setup windows

Examples:
  aether search firefox
  aether install firefox git
  aether setup developer

Standard Linux commands and pacman remain available.
HELP
}

run_root() {
  if [ "$EUID" -eq 0 ]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    echo "This operation requires root privileges, but sudo is unavailable." >&2
    return 1
  fi
}

if [ "$#" -eq 0 ]; then
  cmd=help
else
  cmd="$1"
fi

case "$cmd" in
  help|-h|--help)
    usage
    ;;
  info)
    printf 'AETHER OS\nKernel: '
    uname -r
    printf 'Architecture: '
    uname -m
    printf 'Memory: '
    free -h | awk '/^Mem:/ {print $2 " total, " $7 " available"}'
    ;;
  network)
    ip -brief address
    ;;
  update)
    run_root pacman -Syu
    ;;
  search)
    shift
    [ "$#" -gt 0 ] || { echo "Usage: aether search TERM" >&2; exit 2; }
    pacman -Ss "$*"
    ;;
  install)
    shift
    [ "$#" -gt 0 ] || { echo "Usage: aether install PACKAGE [PACKAGE...]" >&2; exit 2; }
    run_root pacman -S --needed "$@"
    ;;
  remove)
    shift
    [ "$#" -gt 0 ] || { echo "Usage: aether remove PACKAGE [PACKAGE...]" >&2; exit 2; }
    run_root pacman -Rns "$@"
    ;;
  setup)
    [ "$#" -ge 2 ] || { echo "Usage: aether setup {developer|windows}" >&2; exit 2; }
    case "$2" in
      developer)
        run_root pacman -S --needed git base-devel nodejs npm python python-pip go rustup
        ;;
      windows)
        run_root pacman -S --needed wine winetricks flatpak
        run_root flatpak remote-add --if-not-exists --system flathub \
          https://flathub.org/repo/flathub.flatpakrepo
        run_root flatpak install --system --assumeyes flathub com.usebottles.bottles
        ;;
      *)
        echo "Usage: aether setup {developer|windows}" >&2
        exit 2
        ;;
    esac
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage
    exit 2
    ;;
esac
